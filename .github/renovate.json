{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    ":dependencyDashboard"
  ],
  "schedule": [
    "on the 2nd and 4th day instance on sunday after 9pm"
  ],
  "ignoreUnstable": true,
  "labels": [
    "dependencies"
  ],
  "branchPrefix": "renovate/",
  "rangeStrategy": "update-lockfile",
  "timezone": "America/New_York",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "vulnerability"
    ]
  },
  "packageRules": [
    {
      "description": "Group all dependencies from the api directory",
      "matchFileNames": [
        "api/**"
      ],
      "groupName": "Api",
      "reviewers": [
        "chouinar",
        "hao10282025-sudo"
      ]
    },
    {
      "description": "Group all dependencies from the frontend directory",
      "matchFileNames": [
        "frontend/**"
      ],
      "groupName": "Frontend",
      "reviewers": [
        "doug-s-nava",
        "chay-REIsys",
        "glenblosser-nava",
        "nathan-stricker",
        "dghazvini"
      ]
    },
    {
      "description": "Group all dependencies from the infra directory",
      "matchFileNames": [
        "infra/**"
      ],
      "groupName": "Infra",
      "reviewers": [
        "mdragon",
        "chouinar",
        "prasnava",
        "sean-navapbc"
      ]
    },
    {
      "description": "Group all dependencies from the .github directory",
      "matchFileNames": [
        ".github/**"
      ],
      "groupName": "CI/CD",
      "reviewers": [
        "chouinar",
        "prasnava",
        "sean-navapbc"
      ]
    },
    {
      "description": "Group React packages together",
      "matchPackageNames": [
        "react",
        "@types/react",
        "react-dom",
        "@types/react-dom"
      ],
      "groupName": "React",
      "reviewers": [
        "doug-s-nava",
        "glenblosser-nava",
        "nathan-stricker",
        "dghazvini"
      ]
    },
    {
      "description": "Group Storybook packages together",
      "matchPackageNames": [
        "/storybook/"
      ],
      "groupName": "Storybook",
      "reviewers": [
        "doug-s-nava",
        "glenblosser-nava",
        "nathan-stricker",
        "dghazvini"
      ]
    },
    {
      "description": "Group Next.js packages together",
      "matchPackageNames": [
        "/next/"
      ],
      "groupName": "Next.js",
      "reviewers": [
        "doug-s-nava",
        "glenblosser-nava",
        "nathan-stricker",
        "dghazvini"
      ]
    },
    {
      "description": "Group I18next packages together",
      "matchPackageNames": [
        "/i18next/"
      ],
      "groupName": "I18next",
      "reviewers": [
        "doug-s-nava",
        "glenblosser-nava",
        "nathan-stricker",
        "dghazvini"
      ]
    },
    {
      "description": "Group test packages together",
      "enabled": false,
      "matchPackageNames": [
        "/jest/",
        "/testing-library/"
      ],
      "groupName": "Jest"
    },
    {
      "description": "Group CSS-related packages together",
      "enabled": false,
      "matchPackageNames": [
        "/postcss/",
        "/sass/"
      ],
      "groupName": "Styling"
    },
    {
      "description": "@uswds/uswds must match the version that react-uswds depends on, so it should be manually updated. If this isn't here, uswds updates will be included in frontend updates. If a renovate PR fails because of the @uswds/uswds package version, manually update that package version in the PR and that should fix the issue.",
      "enabled": false,
      "matchPackageNames": [
        "@uswds/uswds"
      ],
      "groupName": "USWDS core"
    },
    {
      "description": "Leave peer dependencies alone",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    },
    {
      "description": "Leave Postgres Docker version alone - we want it to match our AWS version",
      "enabled": false,
      "matchFileNames": [
        "api/docker-compose.yml"
      ],
      "matchPackageNames": [
        "/postgres/"
      ]
    },
    {
      "description": "Don't upgrade Python itself as annual releases reflect as minor version bumps",
      "enabled": false,
      "matchFileNames": [
        "api/pyproject.toml",
        "api/docker-python-base"
      ],
      "matchPackageNames": [
        "/python/"
      ]
    },
    {
      "description": "The API's python base image is built by .github/workflows/cd-python-base-image.yml and pinned in api/Dockerfile as a short-sha tag plus digest, so it has no version stream for Renovate to follow. Bump it by hand from that workflow's summary output.",
      "enabled": false,
      "matchPackageNames": [
        "ghcr.io/hhs/sgm-python-base-image"
      ]
    }
  ]
}
