#!/bin/bash
#
# Regenerate documentation/architecture/diagrams/svg/ from
# documentation/architecture/architecture.dsl. Requires Docker only.
#
# Usage (from the repository root):
#   make update-architecture-diagrams
#
# Images are pinned by digest so every machine produces the same SVGs.
set -euo pipefail

structurizr_image="structurizr/structurizr@sha256:721136283c2f9cf1ba69037bc9de136c579d66fdcb2d771cb60546ec68def1a5"
plantuml_image="plantuml/plantuml@sha256:d08610df482510844382caa4e016ba2bf7e3231f630f02ee12f250f3416c62b1" # 1.2026.8

docs_dir="$(cd "$(dirname "$0")/../documentation/architecture" && pwd)"
puml_dir="${docs_dir}/diagrams/puml"
trap 'rm -rf "${puml_dir}"' EXIT

echo "==> Exporting views from architecture.dsl"
rm -rf "${puml_dir}"
if ! output=$(docker run --rm -v "${docs_dir}":/w "${structurizr_image}" \
  export -workspace /w/architecture.dsl -format plantuml/structurizr -output /w/diagrams/puml 2>&1) ||
  grep -q "Exception" <<<"${output}"; then
  grep -i "exception" <<<"${output}" >&2
  echo "Export failed: fix architecture.dsl and try again." >&2
  exit 1
fi

echo "==> Rendering SVGs"
docker run --rm -v "${docs_dir}/diagrams":/d "${plantuml_image}" -tsvg -o /d/svg /d/puml/

# Drop the "structurizr-" prefix so the image links in architecture.md keep working.
for file in "${docs_dir}"/diagrams/svg/structurizr-*.svg; do
  mv "${file}" "${file/structurizr-/}"
done

echo "Done: documentation/architecture/diagrams/svg/"
